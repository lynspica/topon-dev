# CG movie: smooth lattice -> non-ideal melt, DENSELY sampled through the
# transition. Inflation is driven by a ramped soft push under bounded dynamics;
# dumping EVERY step (not every 4) gives enough raw frames in the fast part of
# the transition that frame-selection can pace it smoothly.
read_restart    1.restart
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     mode single cutoff 5.0

bond_style      harmonic
bond_coeff      1 466.1 0.97
angle_style     harmonic
angle_coeff     1 466.1 180.0

# --- Phase A: soft-prefactor ramp under nve/limit, dump EVERY step ---
pair_style      soft 1.0
pair_coeff      * * 0.0
reset_timestep  0
dump            dA all custom 1 infl.lammpstrj id type x y z
dump_modify     dA sort id first yes
variable        pf equal "ramp(2, 26)"
fix             push all adapt 1 pair soft a * * v_pf
fix             a all nve/limit 0.04
run             600
unfix           push
unfix           a
undump          dA

# --- Phase B: real excluded volume (LJ epsilon ramp) + NVT tail, coarse dump ---
pair_style      lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5
reset_timestep  0
dump            dB all custom 15 therm.lammpstrj id type x y z
dump_modify     dB sort id first yes
variable        s equal "ramp(0.02, 1.0)"
fix             ad all adapt 1 pair lj/cut epsilon * * v_s
fix             b all nve/limit 0.08
run             600
unfix           ad
unfix           b
fix             c all nvt temp 1.0 1.0 1.0
run             560
unfix           c
