# anneal_00_init.in (MARTINI 3 port of topro CHARMM anneal_00_init.in)
#
# Reads:  ../system_equilibrated.data
# Writes: anneal_00.restart, anneal_00_minimized.data
# Use:    place this in <run>/annealing/, then run from that directory.
#
# Differences from topro/CHARMM annealing (each marked inline):
#   * pair_style lj/cut/coul/cut    (vs lj/charmm/coul/long + pppm)
#   * dielectric 15.0               (MARTINI reaction-field approximation)
#   * special_bonds lj/coul 0 0 0   (vs special_bonds charmm)
#   * angle_style cosine/squared    (MARTINI 3 IDP backbone funct=10)
#   * NO fix cmap                   (CMAP is CHARMM-only)
#   * NO fix shake on water         (MARTINI W is a single bead, no internal bonds)
#   * timestep 1.0 fs initially     (matches topro for stable warmup; can bump
#                                    to 20 fs for production once equilibrated)
#   * comm_modify cutoff 60.0       (MARTINI bonds longer than atomistic)
#   * velocity gen T = 310 K        (MARTINI canonical, vs CHARMM 300 K)

units           real
timestep        1.0
boundary        p p p

atom_style      full
bond_style      harmonic
angle_style     cosine/squared
dihedral_style  charmm
improper_style  harmonic

pair_style      lj/cut/coul/cut 12.0
pair_modify     shift yes
special_bonds   lj 0.0 0.0 0.0 coul 0.0 0.0 0.0
dielectric      15.0

# Reads the equilibrated network from stage 3 of relaxation/.
read_data       ../system_equilibrated.data
include         ../protein_network.in.settings
include         ../protein_network.in.groups

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     mode single cutoff 60.0

# -------------------- Thermo -------------------- #
thermo          100
thermo_style    custom step pe ke etotal evdwl ebond epair eangle edihed eimp press vol density temp

# -------------------- Tight minimisation -------------------- #
min_style       cg
minimize        1.0e-5 1.0e-7 50000 500000
write_data      anneal_00_minimized.data

# -------------------- Initialise velocities at 310 K -------------------- #
reset_timestep  0
velocity        all create 310 482931 dist gaussian loop local

# -------------------- Short NVT warmup (5 ps at 310 K) -------------------- #
thermo          500
thermo_style    custom step vol temp press density etotal pe ke lx ly lz evdwl ebond epair eangle

fix             nvt all nvt temp 310 310 100.0
run             5000
unfix           nvt

write_restart   anneal_00.restart
print           "anneal_00_init complete -- ready for anneal_01_settle.in"
