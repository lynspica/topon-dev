# LAMMPS Stage 3: CG Equilibration (FENE Restore)

read_restart    2.restart

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# --- Phase A: Harmonic Pre-Minimization ---
bond_style      harmonic
bond_coeff      1 466.1 0.97
angle_style     harmonic
angle_coeff     1 466.1 180.0
pair_style      lj/cut 1.122462
pair_coeff      * * 1.0 1.0 1.122462
min_style       cg
minimize        1.0e-4 1.0e-6 1000 10000

# --- Phase B: Switch to FENE ---
delete_bonds    all angle 1-1 remove
bond_style      fene
special_bonds   fene
bond_coeff      1 30.0 1.5 1.0 1.0
minimize        1.0e-4 1.0e-6 1000 10000

# --- Phase C: Dynamics ---
reset_timestep  0
timestep        0.005
velocity        all create 1.0 12345

fix             1 all nvt temp 1.0 1.0 1.0
thermo          1000
run             10000
unfix           1

write_data      system_equilibrated.data
