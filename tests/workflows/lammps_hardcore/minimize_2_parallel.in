# LAMMPS Stage 2: CG Harmonic Ramp (Reference Logic)

read_restart    1.restart

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     mode single cutoff 5.0

# SWITCH TO HARMONIC for Robust Minimization
bond_style      harmonic
bond_coeff      1 466.1 0.97
angle_style     harmonic
angle_coeff     1 466.1 180.0

# Soft to Real Potential Ramp
#pair_style      soft 1.0
#pair_coeff      * * 1.0
min_style       cg
minimize        1e-4 1e-6 1000 10000

pair_style      lj/cut 1.122462
pair_coeff      * * 1.0 1.0 1.122462
#variable        scale equal "ramp(0.1, 1.0)"
#fix             1 all adapt 1 pair lj/cut epsilon * * v_scale
fix             fxnve all nve/limit 0.1
thermo          1000
run             20000
unfix           fxnve
#unfix           1

write_restart   2.restart
write_data      system_ramped.data
