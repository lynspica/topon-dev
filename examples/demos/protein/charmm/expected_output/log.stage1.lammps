# Group and SHAKE-type definitions -- auto-generated by topro
# Include this file after read_data in every LAMMPS input script.

# --- Water and ion groups ---
# (no water molecules in this system)
# (no ions in this system)
group           protein union all
11086 atoms in group protein

# --- Per-chain groups ---
group           chain01  molecule 1
1384 atoms in group chain01
group           chain02  molecule 2
1387 atoms in group chain02
group           chain03  molecule 3
1384 atoms in group chain03
group           chain04  molecule 4
1385 atoms in group chain04
group           chain05  molecule 5
1387 atoms in group chain05
group           chain06  molecule 6
