# --- 4. Switch to Real Potential ---
pair_style      lj/cut/coul/long 10.0 10.0
kspace_style    pppm 1.0e-4
include         ../02_Chemistry/system.in.settings
# Forcefield Settings (Auto-Generated)

# Pair Coeffs
pair_coeff 1 1 0.0010 3.5000 # Si_
pair_coeff 2 2 0.3100 3.8041 # Si3
pair_coeff 3 3 0.0951 3.4730 # C_3
pair_coeff 4 4 0.0957 3.0332 # O_3
pair_coeff 5 5 0.0010 3.5000 # O_

# Bond Coeffs
bond_coeff 1 350.0000 1.6970 # C_3-Si3
bond_coeff 2 350.0000 1.5870 # O_3-Si3
bond_coeff 3 350.0000 1.5000 # O_-Si_
bond_coeff 4 350.0000 1.5000 # O_-Si3
bond_coeff 5 350.0000 1.5000 # O_3-Si_

# Angle Coeffs
angle_coeff 1 50.0000 109.5000 # O_-Si_-O_
angle_coeff 2 50.0000 109.5000 # O_-Si_-O_3
angle_coeff 3 50.0000 109.5000 # O_3-Si_-O_3
angle_coeff 4 50.0000 109.4710 # C_3-Si3-C_3
angle_coeff 5 50.0000 109.4710 # C_3-Si3-O_3
angle_coeff 6 50.0000 109.4710 # C_3-Si3-O_
angle_coeff 7 50.0000 109.4710 # O_-Si3-O_3
angle_coeff 8 50.0000 104.5100 # Si3-O_3-Si3
angle_coeff 9 50.0000 109.4710 # O_3-Si3-O_3
angle_coeff 10 50.0000 104.5100 # Si3-O_3-Si_
angle_coeff 11 50.0000 109.5000 # Si3-O_-Si_

# Dihedral Coeffs
dihedral_coeff 1 0.333333 -1 3 # C_3-Si3-O_3-Si3
dihedral_coeff 2 0.333333 -1 3 # O_-Si3-O_3-Si3
dihedral_coeff 3 0.333333 -1 3 # O_3-Si3-O_3-Si3
dihedral_coeff 4 0.333333 -1 3 # O_3-Si3-O_3-Si_
dihedral_coeff 5 0.333333 -1 3 # C_3-Si3-O_3-Si_
dihedral_coeff 6 0.000000 1 0 # O_-Si_-O_-Si3
dihedral_coeff 7 0.000000 1 0 # C_3-Si3-O_-Si_
dihedral_coeff 8 0.000000 1 0 # O_3-Si3-O_-Si_
dihedral_coeff 9 0.000000 1 0 # O_-Si_-O_3-Si3
dihedral_coeff 10 0.000000 1 0 # O_3-Si_-O_3-Si3
dihedral_coeff 11 0.000000 1 0 # O_3-Si_-O_-Si3


# Enforce Set 1 Special Bonds
special_bonds   lj/coul 0.0 0.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
